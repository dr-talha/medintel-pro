{
  "version": "2.0",
  "categories": [
    {
      "id": "cardiology",
      "label": "Cardiology",
      "icon": "❤️",
      "calculators": [
        {
          "id": "chads_vasc",
          "name": "CHA₂DS₂-VASc Score",
          "description": "Stroke risk in atrial fibrillation",
          "inputs": [
            { "id": "chf",      "label": "Congestive Heart Failure",        "type": "boolean" },
            { "id": "htn",      "label": "Hypertension",                    "type": "boolean" },
            { "id": "age",      "label": "Age (years)",                     "type": "number", "min": 0, "max": 120 },
            { "id": "diabetes", "label": "Diabetes Mellitus",               "type": "boolean" },
            { "id": "stroke",   "label": "Prior Stroke / TIA / TE",         "type": "boolean" },
            { "id": "vascular", "label": "Vascular Disease (MI, PAD, etc)", "type": "boolean" },
            { "id": "sex",      "label": "Sex",                             "type": "select", "options": ["Male","Female"] }
          ],
          "reference": "Lip GY et al. Chest. 2010;137(2):263-272"
        },
        {
          "id": "map",
          "name": "Mean Arterial Pressure",
          "description": "Average arterial pressure during one cardiac cycle",
          "inputs": [
            { "id": "sbp", "label": "Systolic BP (mmHg)",  "type": "number", "min": 0, "max": 300 },
            { "id": "dbp", "label": "Diastolic BP (mmHg)", "type": "number", "min": 0, "max": 200 }
          ],
          "reference": "MAP = DBP + 1/3(SBP − DBP)"
        }
      ]
    },
    {
      "id": "nephrology",
      "label": "Nephrology",
      "icon": "🫘",
      "calculators": [
        {
          "id": "gfr_ckd_epi",
          "name": "GFR — CKD-EPI 2021",
          "description": "Estimated glomerular filtration rate (race-free formula)",
          "inputs": [
            { "id": "creatinine", "label": "Serum Creatinine (mg/dL)", "type": "number", "min": 0.1, "max": 30 },
            { "id": "age",        "label": "Age (years)",              "type": "number", "min": 18, "max": 120 },
            { "id": "sex",        "label": "Sex",                      "type": "select", "options": ["Male","Female"] }
          ],
          "reference": "Inker LA et al. NEJM. 2021;385:1737-1749"
        },
        {
          "id": "cockroft_gault",
          "name": "Creatinine Clearance — Cockcroft-Gault",
          "description": "Estimated creatinine clearance for drug dosing",
          "inputs": [
            { "id": "age",        "label": "Age (years)",                 "type": "number", "min": 18, "max": 120 },
            { "id": "weight",     "label": "Weight (kg)",                 "type": "number", "min": 1, "max": 300 },
            { "id": "creatinine", "label": "Serum Creatinine (mg/dL)",   "type": "number", "min": 0.1, "max": 30 },
            { "id": "sex",        "label": "Sex",                         "type": "select", "options": ["Male","Female"] }
          ],
          "reference": "Cockcroft DW, Gault MH. Nephron. 1976;16(1):31-41"
        }
      ]
    },
    {
      "id": "critical_care",
      "label": "Critical Care",
      "icon": "🏥",
      "calculators": [
        {
          "id": "sofa",
          "name": "SOFA Score",
          "description": "Sequential Organ Failure Assessment — ICU mortality prediction",
          "inputs": [
            { "id": "pao2_fio2",  "label": "PaO₂/FiO₂ ratio",           "type": "number", "min": 0, "max": 600 },
            { "id": "platelets",  "label": "Platelets (×10³/μL)",        "type": "number", "min": 0, "max": 1000 },
            { "id": "bilirubin",  "label": "Bilirubin (mg/dL)",          "type": "number", "min": 0, "max": 50 },
            { "id": "map",        "label": "Mean Arterial Pressure",     "type": "number", "min": 0, "max": 200 },
            { "id": "gcs",        "label": "Glasgow Coma Scale (3–15)",  "type": "number", "min": 3, "max": 15 },
            { "id": "creatinine", "label": "Creatinine (mg/dL)",         "type": "number", "min": 0, "max": 30 }
          ],
          "reference": "Vincent JL et al. Intensive Care Med. 1996;22(7):707-710"
        },
        {
          "id": "gcs",
          "name": "Glasgow Coma Scale",
          "description": "Level of consciousness assessment",
          "inputs": [
            { "id": "eye",    "label": "Eye Opening (1–4)",    "type": "number", "min": 1, "max": 4 },
            { "id": "verbal", "label": "Verbal Response (1–5)","type": "number", "min": 1, "max": 5 },
            { "id": "motor",  "label": "Motor Response (1–6)", "type": "number", "min": 1, "max": 6 }
          ],
          "reference": "Teasdale G, Jennett B. Lancet. 1974;2(7872):81-84"
        }
      ]
    },
    {
      "id": "general",
      "label": "General Medicine",
      "icon": "🩺",
      "calculators": [
        {
          "id": "bmi",
          "name": "Body Mass Index (BMI)",
          "description": "Weight classification based on height and weight",
          "inputs": [
            { "id": "weight", "label": "Weight (kg)", "type": "number", "min": 1, "max": 500 },
            { "id": "height", "label": "Height (m)",  "type": "number", "min": 0.5, "max": 2.5 }
          ],
          "reference": "WHO BMI classification. 2000"
        }
      ]
    },
    {
      "id": "obstetrics",
      "label": "Obstetrics",
      "icon": "🤰",
      "calculators": [
        {
          "id": "apgar",
          "name": "Apgar Score",
          "description": "Neonatal assessment at 1 and 5 minutes",
          "inputs": [
            { "id": "appearance",   "label": "Appearance (Skin color, 0–2)",    "type": "number", "min": 0, "max": 2 },
            { "id": "pulse",        "label": "Pulse Rate (0–2)",                "type": "number", "min": 0, "max": 2 },
            { "id": "grimace",      "label": "Grimace/Reflex (0–2)",            "type": "number", "min": 0, "max": 2 },
            { "id": "activity",     "label": "Activity/Muscle Tone (0–2)",      "type": "number", "min": 0, "max": 2 },
            { "id": "respiration",  "label": "Respiration (0–2)",               "type": "number", "min": 0, "max": 2 }
          ],
          "reference": "Apgar V. Anesth Analg. 1953;32(4):260-267"
        }
      ]
    },
    {
      "id": "nutrition",
      "label": "Nutrition",
      "icon": "🥗",
      "calculators": [
        {
          "id": "harris_benedict",
          "name": "Harris-Benedict BMR",
          "description": "Basal Metabolic Rate estimation",
          "inputs": [
            { "id": "weight",   "label": "Weight (kg)",   "type": "number", "min": 1, "max": 500 },
            { "id": "height",   "label": "Height (cm)",   "type": "number", "min": 50, "max": 250 },
            { "id": "age",      "label": "Age (years)",   "type": "number", "min": 1, "max": 120 },
            { "id": "sex",      "label": "Sex",           "type": "select", "options": ["Male","Female"] }
          ],
          "reference": "Harris JA, Benedict FG. Proc Natl Acad Sci USA. 1918;4(12):370-373"
        }
      ]
    }
  ]
}
